{
	// Formatters
	"[blade]": {
		"editor.defaultFormatter": "shufo.vscode-blade-formatter"
	},
	"[css]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[html]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[javascript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[json]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[jsonl]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[php]": {
		"editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
	},
	"[scss]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[typescript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"breadcrumbs.enabled": false,
	// Breadcrumbs
	// Chat
	"chat.agent.codeBlockProgress": false,
	"chat.agent.collapseCompletedResponses": false,
	"chat.agent.enabled": false,
	"chat.agentHost.byokModels.enabled": false,
	"chat.agentHost.claudeAgent.enabled": false,
	"chat.agentHost.codexAgent.enabled": false,
	"chat.agentHost.copilot.toolSearch.enabled": false,
	"chat.agentHost.githubMcpServer.enabled": false,
	"chat.agentHost.systemProxy.enabled": false,
	"chat.agentsControl.enabled": "hidden",
	"chat.artifactTools.enabled": false,
	"chat.checkpoints.enabled": false,
	"chat.contextUsage.enabled": false,
	"chat.copilot.hydraFusion.enabled": false,
	"chat.copilot.tgrep.enabled": false,
	"chat.customizations.migration.enabled": false,
	"chat.customizations.promptMigration.enabled": false,
	"chat.detectParticipant.enabled": false,
	"chat.disableAIFeatures": true,
	"chat.editor.localAgent.enabled": false,
	"chat.editor.wordWrap": "on",
	"chat.experimental.stickyScroll.enabled": false,
	"chat.extensionTools.enabled": false,
	"chat.extensionUnification.enabled": false,
	"chat.harnessSwitchFeedbackSurvey.enabled": false,
	"chat.implicitContext.enabled": {
		"panel": "never"
	},
	"chat.math.enabled": false,
	"chat.mcp.apps.enabled": false,
	"chat.mcp.workspaceRootConfig.enabled": false,
	"chat.microsoftAuthentication.enabled": "never",
	"chat.plugins.enabled": false,
	"chat.progressBorder.enabled": false,
	"chat.remoteAgentHostsEnabled": false,
	"chat.stickyScroll.enabled": false,
	"chat.tips.enabled": false,
	"chat.titleBar.openInAgentsWindow.enabled": false,
	"chat.titleBar.signIn.enabled": false,
	"chat.tools.confirmationCarousel.enabled": false,
	"chat.tools.riskAssessment.enabled": false,
	"chat.tools.terminal.blockDetectedFileWrites": "never",
	"chat.tools.terminal.enableAutoApprove": false,
	"chat.viewSessions.enabled": false,
	"chat.welcomePage.signIn.enabled": false,
	"diffEditor.ignoreTrimWhitespace": false,
	"diffEditor.renderSideBySide": false,
	// Diff Editor
	"diffEditor.wordWrap": "on",
	// Editor
	"editor.acceptSuggestionOnCommitCharacter": false,
	"editor.acceptSuggestionOnEnter": "off",
	"editor.accessibilityPageSize": 1,
	"editor.accessibilitySupport": "off",
	"editor.allowVariableFonts": false,
	"editor.allowVariableLineHeights": false,
	"editor.autoClosingBrackets": "always",
	"editor.autoClosingComments": "always",
	"editor.autoClosingDelete": "always",
	"editor.autoClosingOvertype": "always",
	"editor.autoClosingQuotes": "always",
	"editor.autoIndent": "keep",
	"editor.autoIndentOnPasteWithinString": false,
	"editor.autoSurround": "never",
	"editor.bracketPairColorization.enabled": false,
	"editor.codeActionsOnSave": {
		"source.addMissingImports.ts": "always",
		"source.fixAll.eslint": "always",
		"source.fixAll.prettier": "always",
		"source.fixAll.ts": "always",
		"source.organizeImports": "always",
		"source.removeUnused.ts": "always",
		"source.removeUnusedImports": "always",
		"source.sort.json": "always",
		"source.sortImports": "always"
	},
	"editor.codeActionWidget.includeNearbyQuickFixes": false,
	"editor.codeActionWidget.showHeaders": false,
	"editor.codeLens": false,
	"editor.colorDecorators": false,
	"editor.comments.ignoreEmptyLines": false,
	"editor.comments.insertSpace": false,
	"editor.copyWithSyntaxHighlighting": false,
	"editor.cursorBlinking": "solid",
	"editor.cursorSmoothCaretAnimation": "off",
	"editor.cursorStyle": "block",
	"editor.cursorSurroundingLines": 3,
	"editor.defaultColorDecorators": "never",
	"editor.detectIndentation": false,
	"editor.doubleClickSelectsBlock": false,
	"editor.dragAndDrop": false,
	"editor.dropIntoEditor.enabled": false,
	"editor.dropIntoEditor.showDropSelector": "never",
	"editor.editContext": false,
	"editor.emptySelectionClipboard": false,
	"editor.experimental.asyncTokenization": false,
	"editor.find.addExtraSpaceOnTop": false,
	"editor.find.cursorMoveOnType": false,
	"editor.find.findOnType": false,
	"editor.find.history": "never",
	"editor.find.loop": false,
	"editor.find.replaceHistory": "never",
	"editor.find.seedSearchStringFromSelection": "never",
	"editor.folding": true,
	"editor.foldingHighlight": false,
	"editor.foldingMaximumRegions": 10,
	"editor.foldingStrategy": "indentation",
	"editor.fontFamily": "'DejaVu Sans Mono', 'Liberation Mono', Terminus, monospace",
	"editor.fontLigatures": false,
	"editor.fontSize": 13,
	"editor.fontWeight": "500",
	"editor.formatOnSave": true,
	"editor.formatOnType": false,
	"editor.fullwidthCharacterWidth": "twoCells",
	"editor.gotoLocation.multipleDeclarations": "goto",
	"editor.gotoLocation.multipleDefinitions": "goto",
	"editor.gotoLocation.multipleImplementations": "goto",
	"editor.gotoLocation.multipleReferences": "goto",
	"editor.gotoLocation.multipleTypeDefinitions": "goto",
	"editor.guides.bracketPairs": false,
	"editor.guides.bracketPairsHorizontal": false,
	"editor.guides.highlightActiveBracketPair": false,
	"editor.guides.highlightActiveIndentation": false,
	"editor.guides.indentation": false,
	"editor.hideCursorInOverviewRuler": true,
	"editor.hover.delay": 1500,
	"editor.hover.enabled": "off",
	"editor.hover.sticky": false,
	"editor.inlayHints.enabled": "off",
	"editor.inlineSuggest.enabled": false,
	"editor.inlineSuggest.showToolbar": "never",
	"editor.inlineSuggest.syntaxHighlightingEnabled": false,
	"editor.insertSpaces": false,
	"editor.lightbulb.enabled": "off",
	"editor.lineHeight": 1.3,
	"editor.lineNumbers": "off",
	"editor.linkedEditing": true,
	"editor.matchBrackets": "never",
	"editor.maxTokenizationLineLength": 1000,
	"editor.minimap.enabled": false,
	"editor.minimap.renderCharacters": false,
	"editor.minimap.showRegionSectionHeaders": false,
	"editor.multiCursorModifier": "ctrlCmd",
	"editor.occurrencesHighlight": "off",
	"editor.overtypeCursorStyle": "line",
	"editor.overviewRulerBorder": false,
	"editor.padding.bottom": 10,
	"editor.padding.top": 10,
	"editor.parameterHints.enabled": false,
	"editor.pasteAs.enabled": false,
	"editor.pasteAs.showPasteSelector": "never",
	"editor.peekWidgetDefaultFocus": "editor",
	"editor.quickSuggestions": {
		"comments": false,
		"other": false,
		"strings": false
	},
	"editor.rename.enablePreview": false,
	"editor.renderControlCharacters": false,
	"editor.renderLineHighlight": "none",
	"editor.renderWhitespace": "none",
	"editor.roundedSelection": false,
	"editor.scrollbar.horizontal": "hidden",
	"editor.scrollbar.horizontalScrollbarSize": 0,
	"editor.scrollbar.vertical": "hidden",
	"editor.scrollbar.verticalScrollbarSize": 0,
	"editor.scrollBeyondLastLine": false,
	"editor.scrollPredominantAxis": false,
	"editor.selectionHighlight": false,
	"editor.semanticHighlighting.enabled": false,
	"editor.showFoldingControls": "never",
	"editor.smartSelect.selectLeadingAndTrailingWhitespace": false,
	"editor.smoothScrolling": false,
	"editor.snippets.codeActions.enabled": false,
	"editor.snippetSuggestions": "top",
	"editor.stickyScroll.enabled": false,
	"editor.suggest.insertMode": "replace",
	"editor.suggest.showIcons": false,
	"editor.suggest.showSnippets": false,
	"editor.suggestFontSize": 13,
	"editor.suggestLineHeight": 24,
	"editor.suggestOnTriggerCharacters": false,
	"editor.suggestSelection": "first",
	"editor.tabSize": 4,
	"editor.tokenColorCustomizations": {
		"textMateRules": [
			{
				"scope": [
					"comment",
					"keyword",
					"variable.language",
					"entity.other.attribute-name.html",
					"entity.other.attribute-name",
					"keyword.control",
					"storage.type",
					"comment",
					"comment.block",
					"comment.line"
				],
				"settings": {
					"fontStyle": ""
				}
			}
		]
	},
	"editor.unicodeHighlight.allowedLocales": {
		"_os": false,
		"_vscode": false
	},
	"editor.unicodeHighlight.ambiguousCharacters": false,
	"editor.unicodeHighlight.includeComments": false,
	"editor.unicodeHighlight.includeStrings": false,
	"editor.unicodeHighlight.invisibleCharacters": false,
	"editor.unicodeHighlight.nonBasicASCII": false,
	"editor.unusualLineTerminators": "off",
	"editor.wordSeparators": "`~!@#%^&*()=+[{]}\\|;:'\",.<>/?",
	"editor.wrappingIndent": "none",
	// Emmet
	"emmet.includeLanguages": {
		"blade": "html",
		"blade.php": "html",
		"twig": "html",
		"vue": "html",
		"vue-html": "html"
	},
	"emmet.triggerExpansionOnTab": true,
	// Explorer
	"explorer.autoReveal": false,
	"explorer.compactFolders": false,
	"explorer.confirmDelete": true,
	"explorer.confirmDragAndDrop": false,
	"explorer.confirmPasteNative": false,
	"explorer.confirmUndo": "light",
	"explorer.decorations.badges": false,
	"explorer.decorations.colors": false,
	"explorer.enableDragAndDrop": false,
	"explorer.fileNesting.patterns": {
		".php-cs-fixer.php": ".php-cs-fixer.cache",
		"*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
		"*.jsx": "${capture}.js",
		"*.php": "${basename}Test.php",
		"*.ts": "${capture}.js",
		"*.tsx": "${capture}.ts",
		"composer.json": "composer.lock",
		"package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
		"phpunit.xml": ".phpunit.result.cache",
		"psalm.xml": "psalm-baseline.xml",
		"tsconfig.json": "tsconfig.*.json"
	},
	"explorer.openEditors.visible": 1,
	"explorer.sortOrder": "type",
	"extensions.autoCheckUpdates": false,
	"extensions.autoUpdate": "off",
	// Extensions
	"extensions.ignoreRecommendations": true,
	// Files
	"files.associations": {
		".php_cs": "php",
		".php_cs.dist": "php",
		".pre": "php",
		"artisan": "php"
	},
	"files.autoSave": "onFocusChange",
	"files.eol": "\n",
	"files.exclude": {
		"_ide_helper_models.php": true,
		"_ide_helper.php": true,
		".php_cs.cache": true,
		".phpstorm.meta.php": true,
		".phpunit.result.cache": true,
		"**/_ide_helper.php": true,
		"**/.DS_Store": true,
		"**/.git": true,
		"**/.hg": true,
		"**/.idea": true,
		"**/.jj": true,
		"**/.svn": true,
		"**/.vscode": true,
		"**/*.code-search": true,
		"**/bower_components": true,
		"**/composer.lock": true,
		"**/dist": true,
		"**/node_modules": true,
		"**/package-lock.json": true,
		"**/public/{[^i],?[^n]}*": true,
		"**/Thumbs.db": true,
		"**/vendor": true,
		"**/vendor/{[^l],?[^ai]}*": true,
		"storage": true
	},
	"files.insertFinalNewline": true,
	"files.trimFinalNewlines": true,
	"files.trimTrailingWhitespace": true,
	"git.autofetch": false,
	// Git
	"git.autorefresh": false,
	"git.autoRepositoryDetection": false,
	"git.confirmCommittedDelete": false,
	"git.confirmSync": true,
	"git.countBadge": "off",
	"git.decorations.enabled": false,
	"git.enabled": false,
	"git.enableSmartCommit": false,
	"git.inputValidation": true,
	"git.inputValidationLength": 72,
	"git.inputValidationSubjectLength": 50,
	"git.openRepositoryInParentFolders": "never",
	"git.showPushSuccessNotification": false,
	// Image Carousel
	"imageCarousel.chat.enabled": false,
	"imageCarousel.explorerContextMenu.enabled": false,
	// Javascript - Typescript
	"js/ts.experimental.useTsgo": true,
	"js/ts.updateImportsOnFileMove.enabled": "always",
	// JSON
	"json.schemaDownload.enable": false,
	// Live Sass Compile
	"liveSassCompile.settings.generateMap": false,
	"npm.fetchOnlinePackageInfo": false,
	// NPM
	// PHP Namespace Resolver
	"phpNamespaceResolver.autoImportOnSave": true,
	"phpNamespaceResolver.removeOnSave": true,
	"phpNamespaceResolver.sortMode": "alphabetical",
	"phpNamespaceResolver.sortOnSave": true,
	// Prettier
	"prettier.arrowParens": "avoid",
	"prettier.bracketSameLine": true,
	"prettier.experimentalOperatorPosition": "start",
	"prettier.experimentalTernaries": true,
	"prettier.htmlWhitespaceSensitivity": "ignore",
	"prettier.jsxSingleQuote": true,
	"prettier.objectWrap": "collapse",
	"prettier.semi": false,
	"prettier.singleQuote": true,
	"prettier.trailingComma": "none",
	// Problems
	"problems.decorations.enabled": false,
	// SCM
	"scm.diffDecorations": "none",
	// Search
	"search.exclude": {
		"_ide_helper_models.php": true,
		"_ide_helper.php": true,
		".php_cs.cache": true,
		".phpstorm.meta.php": true,
		".phpunit.result.cache": true,
		"**/_ide_helper.php": true,
		"**/.DS_Store": true,
		"**/.git": true,
		"**/.hg": true,
		"**/.idea": true,
		"**/.jj": true,
		"**/.svn": true,
		"**/.vscode": true,
		"**/*.code-search": true,
		"**/bower_components": true,
		"**/composer.lock": true,
		"**/dist": true,
		"**/node_modules": true,
		"**/package-lock.json": true,
		"**/public/{[^i],?[^n]}*": true,
		"**/Thumbs.db": true,
		"**/vendor": true,
		"**/vendor/{[^l],?[^ai]}*": true,
		"storage": true
	},
	"search.followSymlinks": false,
	"search.useIgnoreFiles": false,
	// Security
	"security.workspace.trust.untrustedFiles": "open",
	// Sessions
	"sessions.chat.unifiedWorkspacePicker.enabled": false,
	// Task
	"task.autoDetect": "off",
	// Telemetry
	"telemetry.editStats.enabled": false,
	"telemetry.feedback.enabled": false,
	"telemetry.telemetryLevel": "off",
	// Terminal
	"terminal.integrated.cursorBlinking": true,
	"terminal.integrated.cursorStyle": "underline",
	"terminal.integrated.cursorStyleInactive": "line",
	"terminal.integrated.defaultProfile.linux": "bash",
	"terminal.integrated.enablePersistentSessions": false,
	"terminal.integrated.fontFamily": "'DejaVu Sans Mono', 'Liberation Mono', Terminus, monospace",
	"terminal.integrated.fontSize": 13,
	"terminal.integrated.gpuAcceleration": "off",
	"terminal.integrated.lineHeight": 1.3,
	"terminal.integrated.stickyScroll.enabled": false,
	// Update
	"update.enableWindowsBackgroundUpdates": false,
	"update.mode": "none",
	"update.showReleaseNotes": false,
	"update.titleBar": false,
	// Window
	"window.border": "none",
	"window.commandCenter": false,
	"window.confirmSaveUntitledWorkspace": false,
	"window.customMenuBarAltFocus": false,
	"window.customTitleBarVisibility": "never",
	"window.density.layout": "compact",
	"window.enableMenuBarMnemonics": false,
	"window.menuBarVisibility": "toggle",
	"window.menuStyle": "native",
	"window.newWindowDimensions": "inherit",
	"window.openFoldersInNewWindow": "off",
	"window.restoreWindows": "none",
	"window.titleBarStyle": "native",
	"window.titleSeparator": " ",
	"window.zoomLevel": 0,
	// Workbench
	"workbench.accounts.showAvatar": false,
	"workbench.activityBar.compact": true,
	"workbench.activityBar.location": "hidden",
	"workbench.browser.searchEngine": "none",
	"workbench.browser.showInTitleBar": false,
	"workbench.cloudChanges.autoResume": "off",
	"workbench.cloudChanges.continueOn": "off",
	"workbench.colorCustomizations": {
		"editorStickyScroll.shadow": "#00000000",
		"inlineChat.shadow": "#00000000",
		"listFilterWidget.shadow": "#00000000",
		"panelStickyScroll.shadow": "#00000000",
		"scrollbar.shadow": "#00000000",
		"sideBarStickyScroll.shadow": "#00000000",
		"widget.shadow": "#00000000"
	},
	"workbench.colorTheme": "Dark+",
	"workbench.commandPalette.history": 0,
	"workbench.commandPalette.showAskInChat": false,
	"workbench.editor.customLabels.enabled": false,
	"workbench.editor.decorations.badges": false,
	"workbench.editor.decorations.colors": false,
	"workbench.editor.editorActionsLocation": "hidden",
	"workbench.editor.empty.hint": "hidden",
	"workbench.editor.enablePreview": false,
	"workbench.editor.enablePreviewFromQuickOpen": false,
	"workbench.editor.historyBasedLanguageDetection": false,
	"workbench.editor.languageDetection": false,
	"workbench.editor.languageDetectionHints": {
		"notebookEditors": false,
		"untitledEditors": false
	},
	"workbench.editor.restoreEditors": false,
	"workbench.editor.showTabs": "none",
	"workbench.editor.titleScrollbarVisibility": "hidden",
	"workbench.editor.useModal": "off",
	"workbench.editor.wrapTabs": false,
	"workbench.enableExperiments": false,
	"workbench.experimental.modernUI": false,
	"workbench.experimental.modernUIEditorTabStyle": "pill",
	"workbench.experimental.share.enabled": false,
	"workbench.iconTheme": null,
	"workbench.layoutControl.enabled": false,
	"workbench.layoutControl.type": "toggles",
	"workbench.list.smoothScrolling": false,
	"workbench.localHistory.enabled": false,
	"workbench.modernUIFrostedGlass": false,
	"workbench.navigationControl.enabled": false,
	"workbench.notifications.showInTitleBar": false,
	"workbench.panel.showLabels": false,
	"workbench.productIconTheme": "",
	"workbench.reduceMotion": "on",
	"workbench.reduceTransparency": "on",
	"workbench.secondarySideBar.defaultVisibility": "hidden",
	"workbench.secondarySideBar.showLabels": false,
	"workbench.settings.editor": "json",
	"workbench.settings.enableNaturalLanguageSearch": false,
	"workbench.settings.showAISearchToggle": false,
	"workbench.shadows": false,
	"workbench.sideBar.location": "right",
	"workbench.startupEditor": "none",
	"workbench.statusBar.visible": false,
	"workbench.tips.enabled": false,
	"workbench.tree.enableStickyScroll": false,
	"workbench.tree.indent": 20,
	"workbench.tree.renderIndentGuides": "none",
	"workbench.welcomePage.experimentalOnboarding": false,
	"workbench.welcomePage.walkthroughs.openOnInstall": false,
	"zenMode.centerLayout": false,
	"zenMode.hideLineNumbers": false,
	"zenMode.hideStatusBar": true,
	"zenMode.silentNotifications": true
}
